--TABLE1 - User

CREATE TABLE USER_DETAILS
(
USER_ID BIGINT  AUTO_INCREMENT PRIMARY KEY,
USER_NAME varchar2(50) UNIQUE NOT NULL,
MAIL_ID varchar2(30) UNIQUE NOT NULL,
MOBILE_NUMBER NUMBER(10) NOT NULL,
AGE NUMBER(3),
GENDER varchar2(1),
USER_ROLE varchar2(10) NOT NULL
);

--TABLE 2 - TRAVELS NAME

CREATE TABLE TRAVELS_DETAILS
(
TRAVELS_ID BIGINT AUTO_INCREMENT PRIMARY KEY,
TRAVELLER_NAME VARCHAR2(30),
USER_ID BIGINT REFERENCES USER_DETAILS (USER_ID) ON DELETE CASCADE
);

--TABLE 3 - BUS DETAILS
CREATE TABLE BUS_DETAILS
(
BUS_ID BIGINT AUTO_INCREMENT PRIMARY KEY,
BUS_NUMBER VARCHAR2(20) NOT NULL UNIQUE,
IS_AC_BUS VARCHAR(1) DEFAULT 'N',
TRAVELS_ID BIGINT REFERENCES TRAVELS_DETAILS(TRAVELS_ID) ON DELETE CASCADE
);

--TABLE 4 - SEATS
CREATE TABLE SEAT_DETAILS
(
SEAT_ID BIGINT AUTO_INCREMENT PRIMARY KEY,
SEAT_NUMBER VARCHAR2(3) NOT NULL,
BUS_ID BIGINT REFERENCES BUS_DETAILS(BUS_ID) ON DELETE CASCADE,
CONSTRAINT seat_bus_constraint UNIQUE (SEAT_NUMBER, BUS_ID)
);

--Table 5 - BUS_JOURNEY_DETAILS
CREATE TABLE BUS_JOURNEY_DETAILS
(
BUS_JOURNEY_ID BIGINT AUTO_INCREMENT PRIMARY KEY,
BUS_ID BIGINT REFERENCES BUS_DETAILS(BUS_ID) ON DELETE CASCADE, 
BUS_NUMBER VARCHAR(20) NOT NULL,
FROM_STATION VARCHAR(30) NOT NULL,
TO_STATION VARCHAR(30) NOT NULL,
DATE_OF_DEPARTURE DATE NOT NULL,
DATE_OF_ARRIVAL DATE NOT NULL,
TICKET_PRICE NUMBER(5) NOT NULL,
CONSTRAINT bus_journey_constraint UNIQUE (BUS_ID, DATE_OF_DEPARTURE)
);

--Table 6 - ORDER_DETAILS

CREATE TABLE ORDER_DETAILS
(
ORDER_ID BIGINT AUTO_INCREMENT PRIMARY KEY,
USER_ID BIGINT REFERENCES USER_DETAILS(USER_ID) ON DELETE CASCADE,
ORDER_NUMBER BIGINT,
PAYMENT_MODE VARCHAR2(20) ,
PAYMENT_STATUS VARCHAR2(20) ,
TOTAL_VALUE NUMBER(5)
);


--Table 7 - SEAT_BOOKING_DETAILS

CREATE TABLE SEAT_BOOKING_DETAILS
(
SEAT_BOOKING_ID BIGINT AUTO_INCREMENT PRIMARY KEY,
BUS_JOURNEY_ID BIGINT REFERENCES BUS_JOURNEY_DETAILS(BUS_JOURNEY_ID) ON DELETE CASCADE,
SEAT_ID BIGINT REFERENCES SEAT_DETAILS(SEAT_ID) ON DELETE CASCADE,
IS_SEAT_AVAILABLE VARCHAR(1) DEFAULT 'Y',
--USER_ID BIGINT REFERENCES USER_DETAILS(USER_ID) ON DELETE SET NULL,
BOOKED_DATE DATE,
PASSENGER_NAME VARCHAR(30),
PASSENGER_GENDER VARCHAR(3),
PASSENGER_AGE NUMBER,
ORDER_ID BIGINT REFERENCES ORDER_DETAILS(ORDER_ID),
CONSTRAINT seat_booking_constraint UNIQUE (BUS_JOURNEY_ID, SEAT_ID)
);


